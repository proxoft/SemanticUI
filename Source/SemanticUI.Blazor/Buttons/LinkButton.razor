@inherits SingleButtonBase
@namespace Proxoft.SemanticUI.Blazor

@if (this.IsVisible)
{
    <a href="@Href"
       target="@Target"
       class="@Class()"
       disabled="@Disabled">

        @ChildContent
    </a>
}

@code {
    [Parameter]
    public required string Href { get; set; }

    [Parameter]
    public required string Target { get; set; }
}
