@page "/"
@namespace Proxoft.FomanticUI.Blazor.Sample
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>FomanticUI.Blazor.Sample</title>
    <base href="~/"/>

    @*set UseStaticFiles with desired request path e.g. /sidea-core/fomantic-ui*@
    <link rel="stylesheet" href="/sidea-core/fomantic-ui/semantic.min.css"/>
    <link href="css/site.css" rel="stylesheet"/>
</head>
<body>
<app>
    <component type="typeof(App)" render-mode="ServerPrerendered"/>
</app>

<script src="_framework/blazor.server.js"></script>
</body>
</html>
