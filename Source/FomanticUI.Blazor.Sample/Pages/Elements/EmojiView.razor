@page "/Elements/Emoji"

<h1>Emoji</h1>

<Example Header="Emoji"
         Text="An emoji by its shortcode. Emoji images load from the jsDelivr CDN.">

    <Emoji Name="smile" />
    <Emoji Name=":thumbsup:" />
    <Emoji Name="rocket" />
</Example>

<Example Header="Size"
         Text="An emoji can have different sizes">

    <Emoji Name="smile" Size="Small" />
    <Emoji Name="smile" Size="Medium" />
    <Emoji Name="smile" Size="Large" />
    <Emoji Name="smile" Size="Big" />
</Example>

<Example Header="States"
         Text="An emoji can be a link, disabled or loading">

    <Emoji Name="heart" Size="Large" Decorations="EmojiDecorations.Link" />
    <Emoji Name="heart" Size="Large" Decorations="EmojiDecorations.Disabled" />
    <Emoji Name="heart" Size="Large" Decorations="EmojiDecorations.Loading" />
</Example>
