@page "/Views/Feed"

<h1>Feed</h1>

<Example Header="Feed"
         Text="A feed presents user activity chronologically">

    <Feed>
        <FeedEvent>
            <FeedLabel><img src="/images/avatar/small/elliot.jpg" /></FeedLabel>
            <Content>
                <FeedSummary>
                    <FeedUser Href="#">Elliot Fu</FeedUser> added you as a friend
                    <FeedDate>1 Hour Ago</FeedDate>
                </FeedSummary>
                <MetaInfo>
                    <FeedLike Href="#"><Icon Name="like" /> 4 Likes</FeedLike>
                </MetaInfo>
            </Content>
        </FeedEvent>

        <FeedEvent>
            <FeedLabel><Icon Name="pencil" /></FeedLabel>
            <Content>
                <FeedSummary>
                    You posted on your friend <FeedUser Href="#">Stevie Feliciano</FeedUser>'s wall.
                    <FeedDate>Today</FeedDate>
                </FeedSummary>
                <Extra Decorations="ExtraDecorations.Text">
                    Ours is a life of constant reruns. We're always circling back to where we'd we started.
                </Extra>
                <MetaInfo>
                    <FeedLike Href="#" IsActive="true"><Icon Name="like" /> 5 Likes</FeedLike>
                </MetaInfo>
            </Content>
        </FeedEvent>

        <FeedEvent>
            <FeedLabel><img src="/images/avatar/small/helen.jpg" /></FeedLabel>
            <Content>
                <FeedSummary>
                    <FeedUser Href="#">Helen Troy</FeedUser> added 2 photos
                    <FeedDate>4 days ago</FeedDate>
                </FeedSummary>
                <Extra Decorations="ExtraDecorations.Images">
                    <a><img src="/images/wireframe/image.png" /></a>
                    <a><img src="/images/wireframe/image.png" /></a>
                </Extra>
            </Content>
        </FeedEvent>
    </Feed>
</Example>

<Example Header="Connected and Ordered"
         Text="A feed can connect its events with a line, color it, and number the events">

    <Feed Color="Blue" Decorations="FeedDecorations.Connected | FeedDecorations.Ordered">
        @for (var i = 1; i <= 3; i++)
        {
            <FeedEvent>
                <FeedLabel />
                <Content>
                    <FeedSummary>Step @i</FeedSummary>
                </Content>
            </FeedEvent>
        }
    </Feed>
</Example>

<Example Header="Divided and Size"
         Text="A feed can divide its events and have different sizes">

    <Feed Size="Small" Decorations="FeedDecorations.Divided">
        <FeedEvent>
            <Content>
                <FeedSummary><FeedUser>Tom</FeedUser> joined the team <FeedDate>3 days ago</FeedDate></FeedSummary>
            </Content>
        </FeedEvent>
        <FeedEvent>
            <Content>
                <FeedSummary><FeedUser>Molly</FeedUser> left a comment <FeedDate>2 days ago</FeedDate></FeedSummary>
            </Content>
        </FeedEvent>
    </Feed>
</Example>
