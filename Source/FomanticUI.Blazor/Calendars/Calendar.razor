@inherits FomanticComponent
@namespace Proxoft.FomanticUI.Blazor
@using System.Globalization

@*
    Renders Fomantic UI's calendar markup; navigation, selection and the popup are handled in C#
    instead of Fomantic's jQuery module, so it runs without JS interop (e.g. in Blazor WebAssembly).
*@

<div class="@Class()"
     @attributes="Attributes()"
     @onclick="OnClick">

    @if (this.IsInline)
    {
        <div class="calendar">
            @this.CalendarTable
        </div>
    }
    else
    {
        <div class="ui left icon input">
            <i class="@($"{this.Icon} icon")"></i>
            <input type="text"
                   value="@this.InputText"
                   placeholder="@this.Placeholder"
                   readonly="@(this.State == EditState.ReadOnly)"
                   disabled="@(this.State == EditState.Disabled)"
                   @onclick="this.Open"
                   @onfocus="this.Open"
                   @onchange="this.InputChanged"
                   @onkeydown="this.InputKeyDown" />
        </div>

        @if (_isOpen)
        {
            @* transparent layer closing the popup on a click anywhere outside of it *@
            <div style="position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1899;"
                 @onclick="this.Close">
            </div>

            <div class="@this.PopupClass"
                 style="top: 100%; left: 0; right: auto; z-index: 1900;">
                @this.CalendarTable
            </div>
        }
    }
</div>

@code {
    private CalendarView _view;
    private DateOnly _focus;
    private DateOnly? _lastValue;
    private bool _isOpen;
    private string? _rejectedInput;

    public Calendar() : base("calendar")
    {
    }

    [Parameter]
    public DateOnly? Value { get; set; }

    [Parameter]
    public EventCallback<DateOnly?> ValueChanged { get; set; }

    /// <summary>
    /// What is selected: a date, a month (first day of the month) or a year (January 1st).
    /// </summary>
    [Parameter]
    public CalendarType Type { get; set; }

    /// <summary>
    /// Shows the calendar directly instead of an input with a popup.
    /// </summary>
    [Parameter]
    public bool IsInline { get; set; }

    [Parameter]
    public DateOnly? MinDate { get; set; }

    [Parameter]
    public DateOnly? MaxDate { get; set; }

    /// <summary>
    /// Disables individual days, e.g. weekends.
    /// </summary>
    [Parameter]
    public Func<DateOnly, bool>? IsDisabledDate { get; set; }

    /// <summary>
    /// Defaults to the culture's first day of the week.
    /// </summary>
    [Parameter]
    public DayOfWeek? FirstDayOfWeek { get; set; }

    /// <summary>
    /// Culture for month and day names and for the input format. Defaults to the current culture.
    /// </summary>
    [Parameter]
    public CultureInfo? Culture { get; set; }

    /// <summary>
    /// Input format. Defaults to the culture's short date pattern for dates, year-month pattern for months and "yyyy" for years.
    /// </summary>
    [Parameter]
    public string? Format { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string Icon { get; set; } = "calendar";

    [Parameter]
    public bool ShowToday { get; set; }

    [Parameter]
    public string TodayText { get; set; } = "Today";

    [Parameter]
    public Size Size { get; set; }

    [Parameter]
    public bool IsInverted { get; set; }

    [Parameter]
    public EditState State { get; set; }

    private CultureInfo EffectiveCulture => this.Culture ?? CultureInfo.CurrentCulture;

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private string EffectiveFormat => this.Format ?? this.Type switch
    {
        CalendarType.Month => this.EffectiveCulture.DateTimeFormat.YearMonthPattern,
        CalendarType.Year => "yyyy",
        _ => this.EffectiveCulture.DateTimeFormat.ShortDatePattern
    };

    private string InputText => _rejectedInput
        ?? this.Value?.ToString(this.EffectiveFormat, this.EffectiveCulture)
        ?? "";

    private string PopupClass => new[]
    {
        "ui bottom left popup calendar transition visible",
        "inverted".ToClassIf(this.IsInverted)
    }.ToClass();

    private RenderFragment CalendarTable => __builder =>
    {
        var calendarPage = CalendarPage.Create(_view, _focus, new CalendarOptions(
            this.Today,
            this.Value,
            this.MinDate,
            this.MaxDate,
            this.IsDisabledDate,
            this.FirstDayOfWeek ?? this.EffectiveCulture.DateTimeFormat.FirstDayOfWeek,
            this.EffectiveCulture));

        <table class="@calendarPage.TableClass(this.IsInverted)">
            <thead>
                <tr>
                    <th colspan="@calendarPage.Columns">
                        <span class="link" @onclick="this.ZoomOut">@calendarPage.Header</span>
                        <span class="@("prev link" + (calendarPage.Previous is null ? " disabled" : ""))"
                              @onclick="() => this.Navigate(calendarPage.Previous)">
                            <i class="chevron left icon"></i>
                        </span>
                        <span class="@("next link" + (calendarPage.Next is null ? " disabled" : ""))"
                              @onclick="() => this.Navigate(calendarPage.Next)">
                            <i class="chevron right icon"></i>
                        </span>
                    </th>
                </tr>
                @if (calendarPage.ColumnHeaders.Count > 0)
                {
                    <tr>
                        @foreach (var columnHeader in calendarPage.ColumnHeaders)
                        {
                            <th>@columnHeader</th>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                @foreach (var row in calendarPage.Rows)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td class="@cell.Class" @onclick="() => this.SelectCell(cell)">@cell.Text</td>
                        }
                    </tr>
                }
                @if (this.ShowToday)
                {
                    <tr>
                        <td colspan="@calendarPage.Columns" class="today link" @onclick="this.SelectToday">@this.TodayText</td>
                    </tr>
                }
            </tbody>
        </table>
    };

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var valueChanged = _lastValue != this.Value;
        _lastValue = this.Value;

        // follow the value set by the parent, but don't move the page the user is browsing
        if (_focus == default || (valueChanged && !_isOpen))
        {
            this.ResetPage();
        }
        else if (_view < this.Type.ToView())
        {
            _view = this.Type.ToView();
        }
    }

    protected override IEnumerable<string> Classes()
    {
        yield return this.Size.ToClass();
        yield return "inverted".ToClassIf(this.IsInverted);
        yield return this.State.ToClass();
    }

    protected override void InitializeAttributes(Dictionary<string, object> attributes)
    {
        base.InitializeAttributes(attributes);

        if (!this.IsInline)
        {
            // the popup is positioned below the input by CSS only, relative to this element
            var style = attributes.TryGetValue("style", out var existing) ? $"{existing}; " : "";
            attributes["style"] = style + "position: relative;";
        }
    }

    private bool IsEditable => this.State == EditState.Edit;

    private void ResetPage()
    {
        _focus = this.Value ?? this.Today;
        _view = this.Type.ToView();
    }

    private void Open()
    {
        if (_isOpen || !this.IsEditable)
        {
            return;
        }

        this.ResetPage();
        _isOpen = true;
    }

    private void Close()
    {
        _isOpen = false;
    }

    private void Navigate(DateOnly? focus)
    {
        if (focus is { } f && this.IsEditable)
        {
            _focus = f;
        }
    }

    private void ZoomOut()
    {
        if (!this.IsEditable)
        {
            return;
        }

        _view = _view switch
        {
            CalendarView.Day => CalendarView.Month,
            _ => CalendarView.Year
        };
    }

    private async Task SelectCell(CalendarCell cell)
    {
        if (!cell.IsSelectable || !this.IsEditable)
        {
            return;
        }

        if (_view == this.Type.ToView())
        {
            await this.SetValue(cell.Date);
            return;
        }

        // drill down towards the selected type: year -> month -> day
        _focus = cell.Date;
        _view = _view == CalendarView.Year ? CalendarView.Month : CalendarView.Day;
    }

    private async Task SelectToday()
    {
        var today = this.Type.Normalize(this.Today);
        if (this.IsEditable && this.IsAllowed(today))
        {
            await this.SetValue(today);
        }
    }

    private async Task InputChanged(ChangeEventArgs e)
    {
        var text = (e.Value as string ?? "").Trim();
        if (text.Length == 0)
        {
            await this.SetValue(null);
            return;
        }

        if (this.TryParse(text, out var date) && this.IsAllowed(date))
        {
            await this.SetValue(date);
            return;
        }

        // re-render the rejected text first so the next render restores the formatted value in the input
        _rejectedInput = text;
        this.StateHasChanged();
        await Task.Yield();
        _rejectedInput = null;
    }

    private void InputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Tab")
        {
            this.Close();
        }
    }

    private bool TryParse(string text, out DateOnly date)
    {
        var parsed = DateOnly.TryParseExact(text, this.EffectiveFormat, this.EffectiveCulture, DateTimeStyles.None, out date)
            || DateOnly.TryParse(text, this.EffectiveCulture, DateTimeStyles.None, out date);

        date = this.Type.Normalize(date);
        return parsed;
    }

    private bool IsAllowed(DateOnly date)
    {
        var period = CalendarPage.Create(this.Type.ToView(), date, new CalendarOptions(
            this.Today, null, this.MinDate, this.MaxDate, this.IsDisabledDate,
            this.FirstDayOfWeek ?? this.EffectiveCulture.DateTimeFormat.FirstDayOfWeek, this.EffectiveCulture));

        return period.Rows
            .SelectMany(r => r)
            .Any(c => c.Date == date && c.IsSelectable);
    }

    private async Task SetValue(DateOnly? date)
    {
        var value = date is { } d ? this.Type.Normalize(d) : (DateOnly?)null;

        this.Value = value;
        _lastValue = value;
        if (value is { } v)
        {
            _focus = v;
        }

        _isOpen = false;
        await this.ValueChanged.InvokeAsync(value);
    }
}
