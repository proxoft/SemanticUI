@inherits ContainerFomanticComponent
@namespace Proxoft.FomanticUI.Blazor

<DivTemplate Component="this"/>

@code {

    public Grid() : base("grid")
    {
    }

    [Parameter]
    public Amount Columns { get; set; }

    [Parameter]
    public Position Alignment { get; set; }

    [Parameter]
    public GridDecorations Decorations { get; set; }

    [Parameter]
    public bool IsContainer { get; set; }

    protected override IEnumerable<string> Classes()
    {
        yield return Decorations.ToClass();
        yield return Alignment.ToAlignmentClass();
        yield return Columns.ToClass("column");
    }

    protected override IEnumerable<string> AfterCssNameClasses()
    {
        return base
                .AfterCssNameClasses()
                .Concat(new[]
                {
                    "container".ToClassIf(IsContainer)
                })
            ;
    }

}
