@inherits ContainerFomanticComponent
@namespace Proxoft.FomanticUI.Blazor

<DivTemplate Component="this"/>

@code {

    public Dimmer() : base("dimmer")
    {
    }

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public DimmerDecorations Decorations { get; set; }

    [Parameter]
    public Position Aligned { get; set; }

    protected override IEnumerable<string> Classes()
    {
        yield return Decorations.ToClass();
        yield return "active".ToClassIf(Active);
        yield return Aligned.ToVerticalAlignmentClass();
    }

}
