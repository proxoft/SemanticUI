@inherits ContainerFomanticComponent
@namespace Proxoft.FomanticUI.Blazor

<DivTemplate Component="this"/>

@code {

    public StepPanel() : base("steps")
    {
    }

    [Parameter]
    public StepPanelDecorations Decorations { get; set; }

    [Parameter]
    public Position Attached { get; set; }

    [Parameter]
    public Size Size { get; set; }

    [Parameter]
    public Amount StepsCount { get; set; }

    protected override IEnumerable<string> Classes()
    {
        yield return Decorations.ToClass();
        yield return Attached.ToAttachedClass();
        yield return Size.ToClass();
        yield return StepsCount.ToClass(string.Empty);
    }

}
