@inherits ContainerFomanticComponent
@namespace Proxoft.FomanticUI.Blazor

<DivTemplate Component="this">
    @if (HasIcon)
    {
        <Icon Name="@_effective.Icon" @onclick="OnIconClick" />
    }

    <Content>
        @if (HasHeader)
        {
            <Header>
                @_effective.Header
            </Header>
        }

        @if (HasContent)
        {
            <p>
                @_effective.Content
            </p>
        }
        @if (this.HasItems)
        {
            <ul>
                @foreach (var i in _effective.Items)
                {
                    <li>@i</li>
                }
            </ul>
        }
    </Content>

    @if (_effective.CanClose)
    {
        <Icon Name="close" @onclick="OnCloseIconClick" />
    }
</DivTemplate>

@code {
    private MessageData _effective = new();

    public Message() : base("message")
    {
    }

    /// <summary>
    /// All settings in one value; individual parameters override its values.
    /// </summary>
    [Parameter]
    public MessageData? Data { get; set; }

    [Parameter]
    public Severity? Severity { get; set; }

    [Parameter]
    public Size? Size { get; set; }

    [Parameter]
    public Color? Color { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Header { get; set; }

    [Parameter]
    public string? Content { get; set; }

    [Parameter]
    public bool? CanClose { get; set; }

    [Parameter]
    public bool? Floating { get; set; }

    [Parameter]
    public IEnumerable<string>? Items { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnIconClick { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnCloseIconClick { get; set; }

    private bool HasIcon => !string.IsNullOrWhiteSpace(_effective.Icon);

    private bool HasHeader => !string.IsNullOrWhiteSpace(_effective.Header);

    private bool HasContent => !string.IsNullOrWhiteSpace(_effective.Content);

    private bool HasItems => _effective.Items.Count > 0;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var data = this.Data ?? new MessageData();
        _effective = data with
        {
            Severity = this.Severity ?? data.Severity,
            Size = this.Size ?? data.Size,
            Color = this.Color ?? data.Color,
            Icon = this.Icon ?? data.Icon,
            Header = this.Header ?? data.Header,
            Content = this.Content ?? data.Content,
            CanClose = this.CanClose ?? data.CanClose,
            Floating = this.Floating ?? data.Floating,
            Items = this.Items?.ToArray() ?? data.Items
        };
    }

    protected override IEnumerable<string> Classes()
    {
        yield return "icon".ToClassIf(this.HasIcon);
        yield return _effective.Severity.ToClass();

        if (_effective.Severity == Proxoft.FomanticUI.Core.Severity.NoSeverity)
        {
            yield return _effective.Color.ToClass();
        }

        yield return _effective.Size.ToClass();
        yield return "floating".ToClassIf(_effective.Floating);
    }
}
