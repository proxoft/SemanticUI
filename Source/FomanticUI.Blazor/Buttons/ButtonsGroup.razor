@inherits ButtonBase<ButtonsGroupData>
@namespace Proxoft.FomanticUI.Blazor

@if (this.Effective.IsVisible)
{
    <DivTemplate Component="this" />
}

@code {
    public ButtonsGroup() : base("buttons")
    {
    }

    [Parameter]
    public Orientation? Orientation { get; set; }

    [Parameter]
    public Amount? Amount { get; set; }

    protected override ButtonsGroupData ApplyParameters(ButtonsGroupData data)
    {
        var applied = base.ApplyParameters(data);
        return applied with
        {
            Orientation = this.Orientation ?? applied.Orientation,
            Amount = this.Amount ?? applied.Amount
        };
    }

    protected override IEnumerable<string> Classes()
    {
        return base.Classes()
            .Concat(
                new[] {
                    this.Effective.Orientation.ToClass(),
                    this.Effective.Amount.ToClass(of: "")
                });

    }
}
