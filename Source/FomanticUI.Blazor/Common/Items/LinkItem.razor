@inherits ItemBase
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@namespace Proxoft.FomanticUI.Blazor

<a href="@Href"
   class="@Class()"
   @onclick="OnClick"
   @attributes="UnmatchedAttributes">

    @ChildContent

    @if (HasRightIcon)
    {
        <Icon Name="@(RightIcon ?? "")"/>
    }
</a>

@code {

    public LinkItem() : base("item", false)
    {
    }

    [Inject]
    public NavigationManager NavigationManager { get; set; } = null!;

    [Parameter]
    public required string Href { get; set; }

    [Parameter]
    public ActiveUrlMatch ActiveUrlMatch { get; set; } = None;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += LocationChanged;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        NavigationManager.LocationChanged -= LocationChanged;
        if (ActiveUrlMatch == Exact)
        {
            SetIsActiveFromNavigationManager();
            NavigationManager.LocationChanged += LocationChanged;
        }
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SetIsActiveFromNavigationManager();
    }

    private void SetIsActiveFromNavigationManager()
    {
        if (ActiveUrlMatch == None)
        {
            return;
        }

        IsActive = NavigationManager.BaseUri + Href?.TrimStart('/') == NavigationManager.Uri;
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= LocationChanged;
    }

}