@inherits HeaderBase
@namespace Proxoft.FomanticUI.Blazor

<DivTemplate Component="this"/>

@code {

    public Subheader() : base("sub header", false)
    {
    }

    /// <summary>
    ///     A subheader standing on its own (not inside a header) renders as "ui sub header".
    /// </summary>
    [Parameter]
    public bool IsRoot { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        PrefixUiClass = IsRoot;
    }

}
