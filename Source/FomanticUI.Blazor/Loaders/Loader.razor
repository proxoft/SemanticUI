@inherits FomanticComponent
@namespace Proxoft.FomanticUI.Blazor

<DivTemplate Component="this">
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        @Text
    }
</DivTemplate>

@code {

    public Loader() : base("loader")
    {
    }

    bool Active { get; } = true;

    [Parameter]
    public string Text { get; set; } = "";

    [Parameter]
    public LoaderDecorations Decorations { get; set; }

    [Parameter]
    public Size Size { get; set; }

    protected override IEnumerable<string> Classes()
    {
        yield return "active".ToClassIf(Active);
        yield return Decorations.ToClass();
        yield return Size.ToClass();
    }

}
