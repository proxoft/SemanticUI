@inherits ContainerFomanticComponent
@namespace Proxoft.FomanticUI.Blazor

<Dimmer Active="IsActive"
        Decorations="DimmerDecorations">
    <DivTemplate Component="this"/>
</Dimmer>

@code {

    public Modal() : base("modal")
    {
    }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public ModalDecorations Decorations { get; set; }

    [Parameter]
    public DimmerDecorations DimmerDecorations { get; set; }

    [Parameter]
    public Size Size { get; set; }

    protected override IEnumerable<string> Classes()
    {
        yield return "active".ToClassIf(IsActive);
        yield return Decorations.ToClass();
        yield return Size.ToClass();
    }

}
