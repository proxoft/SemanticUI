@page

<h1>Button</h1>


<sl-example header="Button"
            text="A standard button">
    <fui-button>
        Follow
    </fui-button>
</sl-example>

<sl-example header="Link button"
            text="An achor styled as button">
    <fui-linkButton href="https://fomantic-ui.com/elements/button.html" target="_blank">
        Go to
    </fui-linkButton>
</sl-example>

<sl-example header="Emphasis"
            text="A button can be formatted to show different levels of emphasis">
    <fui-button emphasizes="Primary">
        Save
    </fui-button>
    <fui-button>
        Discard
    </fui-button>
    <fui-button emphasizes="Secondary">
        Save
    </fui-button>
    <fui-button emphasizes="Positive">
        OK
    </fui-button>
    <fui-button emphasizes="Negative">
        False
    </fui-button>
</sl-example>

<sl-example header="Disabled"
            text="A button can show it is currently unable to be interacted with">
    <fui-button state="Disabled">
        Followed
    </fui-button>
</sl-example>

<sl-example header="Loading"
            text="A button can show a loading indicator">
    <fui-button state="Loading">
        Content
    </fui-button>
    <fui-button state="Loading" decoration="Basic">
        Content
    </fui-button>
    <fui-button state="Loading" emphasizes="Primary">
        Content
    </fui-button>
    <fui-button state="Loading" emphasizes="Secondary">
        Content
    </fui-button>
</sl-example>

<sl-example header="Vertical Buttons"
            text="Groups can be formatted to appear vertically">
    <fui-buttonsGroup orientation="Vertical">
        <fui-button>
            Feed
        </fui-button>
        <fui-button>
            Messages
        </fui-button>
        <fui-button>
            Events
        </fui-button>
        <fui-button>
            Photos
        </fui-button>
    </fui-buttonsGroup>
</sl-example>