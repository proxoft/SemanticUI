</sl-example>

<sl-example header="Fixed"
            text="A table can use table-layout: fixed a special faster form of table rendering that does not resize table cells based on content.">
    <fui-table decorations="SingleLine | TableDecorations.Fixed">
        <thead>
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Description</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>John</td>
