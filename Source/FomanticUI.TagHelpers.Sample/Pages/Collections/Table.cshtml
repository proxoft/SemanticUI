@page
@using Proxoft.FomanticUI.Core

<h1>Table</h1>

<sl-example header="Table"
            text="A standard table">
    <fui-table>
        <thead>
        <fui-tr>
            <fui-th>
                Name
            </fui-th>
            <fui-th>
                Age
            </fui-th>
            <fui-th>
                Job
            </fui-th>
        </fui-tr>
        </thead>
        <tbody>
        <fui-tr>
            <fui-td>James</fui-td>
            <fui-td>24</fui-td>
            <fui-td>Engineer</fui-td>
        </fui-tr>
        <fui-tr>
            <fui-td>
                Jill
            </fui-td>
            <fui-td>
                26
            </fui-td>
            <fui-td>
                Engineer
            </fui-td>
        </fui-tr>
        <fui-tr>
            <fui-td>Elyse</fui-td>
            <fui-td>24</fui-td>
            <fui-td>Designer</fui-td>
        </fui-tr>
        </tbody>
    </fui-table>
</sl-example>

<h1>Structured</h1>

<sl-example header="Structured"
            text="A table can be formatted to display complex structured data">
    <fui-table decorations="Celled | TableDecorations.Structured">
        <thead>
        <fui-tr>
            <fui-th row-span="2">
                Name
            </fui-th>
            <fui-th row-span="2">
                Type
            </fui-th>
            <fui-th row-span="2">
                Files
            </fui-th>
            <fui-th col-span="3">
                Languages
            </fui-th>
        </fui-tr>
        <fui-tr>
            <fui-th>
                Ruby
            </fui-th>
            <fui-th>
                Javascript
            </fui-th>
            <fui-th>
                Python
            </fui-th>
        </fui-tr>
        </thead>
        <tbody>
        <fui-tr>
            <fui-td>Alpha Team</fui-td>
            <fui-td>Project 1</fui-td>
            <fui-td alignment="Right">2</fui-td>
            <fui-td alignment="Center">
                <fui-icon name="checkmark"
                          size="Large"
                          color="Green"/>
            </fui-td>
            <fui-td></fui-td>
            <fui-td></fui-td>
        </fui-tr>
        <fui-tr>
            <fui-td row-span="3">Beta Team</fui-td>
            <fui-td>Project 1</fui-td>
            <fui-td alignment="Right">52</fui-td>
            <fui-td alignment="Center">
                <fui-icon name="checkmark"
                          size="Large"
                          color="Green"/>
            </fui-td>
            <fui-td></fui-td>
            <fui-td></fui-td>
        </fui-tr>
        <fui-tr>
            <fui-td>Project 2</fui-td>
            <fui-td alignment="Right">12</fui-td>
            <fui-td></fui-td>
            <fui-td alignment="Center">
                <fui-icon name="checkmark"
                          size="Large"
                          color="Green"/>
            </fui-td>
            <fui-td></fui-td>
        </fui-tr>
        <fui-tr>
            <fui-td>Project 3</fui-td>
            <fui-td alignment="Right">21</fui-td>
            <fui-td alignment="Center">
                <fui-icon name="checkmark"
                          size="Large"
                          color="Green"/>
            </fui-td>
            <fui-td></fui-td>
            <fui-td></fui-td>
        </fui-tr>
        </tbody>
    </fui-table>
</sl-example>

<h1>Variations</h1>

<sl-example header="Single Line"
            text="A table can specify that its cell contents should remain on a single line, and not wrap.">
    <fui-table decorations="SingleLine">
        <thead>
        <fui-tr>
            <fui-th>Name</fui-th>
            <fui-th>Registration Date</fui-th>
            <fui-th>E-mail address</fui-th>
            <fui-th>Premium Plan</fui-th>
        </fui-tr>
        </thead>
        <tbody>
        <fui-tr>
            <fui-td>John Lilki</fui-td>
            <fui-td>September 14, 2013</fui-td>
            <fui-td>jhlilk22@yahoo.com</fui-td>
            <fui-td>No</fui-td>
        </fui-tr>
        <fui-tr>
            <fui-td>Jamie Harington</fui-td>
